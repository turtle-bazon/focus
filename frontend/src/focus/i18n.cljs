(defn t
  "Look up translation for key in given locale, falling back to English."
  [locale key]
  (or (get-in translations [locale key])
      (get-in translations [default-locale key])
      (str "[" (name key) "]")))

(defn locale-display-name
  "Return the native display name for a locale."
  [locale]
  (case locale
    :en "English"
    :ru "Русский"
    :tr "Türkçe"
    :uk "Українська"
    :zh "中文"
    :fr "Français"
    :de "Deutsch"
    :es "Español"
    :ja "日本語"
    :hi "हिन्दी"
    :it "Italiano"
    :ar "العربية"
    :pt "Português"
    :ko "한국어"
    :nl "Nederlands"
    :pl "Polski"
    (name locale)))

(def supported-locales
  "List of supported locale codes in display order."
  [:en :ru :tr :uk :zh :fr :de :es :ja :hi :it :ar :pt :ko :nl :pl])

(defn- detect-browser-locale
  "Detect the best matching locale from the browser's language settings."
  []
  (let [languages (try (or (.-languages js/navigator)
                           (array (.-language js/navigator)))
                       (catch js/Error _ (array)))
        supported (set (map name supported-locales))
        codes (->> languages
                   (mapcat (fn [lang]
                             (let [base (some-> lang
                                                (str/split #"-")
                                                first
                                                str/lower-case)]
                               (when base [base]))))
                   distinct)]
    (some (fn [code]
            (when (contains? supported code)
              (keyword code)))
          codes)))

(defn get-saved-locale
  "Read saved locale from localStorage. If none saved, detect from browser.
   Falls back to default-locale."
  []
  (let [saved (try (.getItem js/localStorage "focus-locale") (catch js/Error _ nil))]
    (cond
      ;; User explicitly chose a locale — use it
      (and saved (some #{(keyword saved)} supported-locales))
      (keyword saved)

      ;; No saved preference — detect from browser
      :else
      (or (detect-browser-locale) default-locale))))

(defn save-locale!
  "Save locale to localStorage."
  [locale]
  (try (.setItem js/localStorage "focus-locale" (name locale))
       (catch js/Error _)))

;;; Re-frame integration

(rf/reg-sub
 :locale
 (fn [db _]
   (or (:locale db) default-locale)))

(rf/reg-event-db
 :set-locale
 (fn [db [_ locale]]
   (save-locale! locale)
   (assoc db :locale locale)))

(rf/reg-sub
 :t
 (fn [[_ key] _]
   (let [locale @(rf/subscribe [:locale])]
     (t locale key))))
